# Copy this file to .env and fill in real values.
# .env is git-ignored — it will never be committed.

# --- KPMG Workbench (Luna, Sol) ---
WORKBENCH_SUBSCRIPTION_KEY=
WORKBENCH_CHARGE_CODE=

# --- Provider mode ---
# Which model providers this environment is allowed to call.
#   workbench  (default, and the value to use on corporate machines)
#              Only Luna and Sol can run. Selecting a Gemini model returns an
#              explicit "not enabled in this environment" error.
#   local      Also allows Gemini 3.6 Flash and Gemini 3.5 Flash.
# Leaving this unset means "workbench": Gemini is never silently enabled.
AI_PROVIDER_MODE=workbench

# --- Google Gemini (Gemini 3.6 Flash, Gemini 3.5 Flash) ---
# Backend-only. Never sent to, or readable by, the frontend.
#
# PRIVACY: Gemini models are intended for LOCAL/DEMO use with approved
# non-sensitive documents. Gemini Free Tier data-use terms differ from
# corporate Workbench terms. Do not send company confidential documents
# through Gemini unless explicitly authorized. This is a policy the operator
# enforces by choosing the model — the application deliberately does NOT
# implement it as automatic routing or fallback.
GEMINI_API_KEY=
