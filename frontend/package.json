{
  "name": "docpercepinterac-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "npm run contracts:check && oxlint && tsc -b && vite build",
    "preview": "vite preview",
    "postinstall": "patch-package",
    "contracts:generate": "node tools/generate-contracts.mjs",
    "contracts:check": "node tools/check-contracts.mjs"
  },
  "dependencies": {
    "docx-preview": "0.4.0",
    "lucide-react": "^1.31.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.12.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "openapi-typescript": "7.13.0",
    "oxlint": "^1.75.0",
    "patch-package": "^8.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
